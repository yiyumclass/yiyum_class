# 이 파일은 필요한 환경변수의 "이름"만 기록한다. 실제 값은 커밋하지 않는다.
# 로컬은 .env.local, 배포는 Vercel 프로젝트 환경변수에 설정한다.

# --- Supabase ---
# 프로젝트 URL과 공개용 anon 키. 클라이언트 번들에 포함되는 공개 값이다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
# Vercel에서는 Production 스코프에만 등록한다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 카카오 회원 탈퇴 ---
# 카카오 로그인 사용 앱의 서비스 앱 어드민 키. 연결 끊기 API에서만 서버 측으로 사용한다.
# 카카오 디벨로퍼스 > 앱 > 플랫폼 키에서 확인하며 절대 NEXT_PUBLIC_을 붙이지 않는다.
KAKAO_ADMIN_KEY=

# --- 사이트 주소 ---
# 프로덕션 도메인(예: https://example.com). 다음 용도로 함께 쓰인다.
#   - metadata/OG 이미지 절대 경로 (src/app/layout.tsx)
#   - robots.txt / sitemap.xml (src/app/robots.ts, sitemap.ts)
#   - 상태 변경 요청의 same-origin 검증 기준 (src/lib/http/origin.ts)
# 주의: Vercel Preview 환경에는 설정하지 말 것.
# 설정하면 프리뷰 도메인과 origin이 어긋나 모든 POST가 403으로 막힌다.
NEXT_PUBLIC_SITE_URL=

# --- 토스페이먼츠 ---
# free | toss_test | toss_live 중 하나.
# 이 세 값이 아니면 조용히 free로 떨어져 결제 UI가 사라지므로 오타에 주의한다.
PAYMENT_MODE=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- OAuth 동의 쿠키 서명 ---
# 카카오 가입 동의 의도를 담은 쿠키의 HMAC 키.
# 미설정 시 SUPABASE_SERVICE_ROLE_KEY로 폴백하므로 반드시 별도 값을 발급한다.
# 예: openssl rand -base64 32
AUTH_CONSENT_SECRET=

# --- SOLAPI 회원가입 환영 알림톡 ---
# 모두 서버 전용이다. 카카오 전화번호 동의항목과 승인된 알림톡 템플릿이 필요하다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_WELCOME_TEMPLATE_ID=

# --- Vercel Cron ---
# 이탈한 pending 주문 정리 작업(/api/cron/expire-pending-orders)의 호출 인증.
# 설정하지 않으면 라우트가 401로 거절하므로 정리 작업이 돌지 않는다.
# 예: openssl rand -base64 32
CRON_SECRET=

# --- 로컬 검증 스크립트 전용 (배포 불필요) ---
# npm run verify:admin-tabs 가 접속할 주소. 기본값 http://localhost:3000
ADMIN_TEST_BASE_URL=
